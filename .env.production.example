# ── Domain ──
DOMAIN=your-domain.com

# ── Anthropic ──
ANTHROPIC_API_KEY=sk-ant-change-me

# ── Database (Supabase connection pooler) ──
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_PASSWORD@db.YOUR_REF.supabase.co:6543/postgres

# ── Redis (local container, password-protected) ──
REDIS_URL=redis://:your-redis-password@redis:6379/0
REDIS_PASSWORD=your-redis-password

# ── Supabase Auth ──
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_ISSUER=https://YOUR_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# ── Frontend (baked into Vite build) ──
VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

# ── App Settings ──
ENVIRONMENT=production
LOG_LEVEL=WARNING
MIROFISH_MODE=mock
MARKET_DATA_PROVIDER=mock

# ── Japan Data (optional — mock mode works without these) ──
REINFOLIB_API_KEY=
ESTAT_APP_ID=
RESAS_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── CORS (your production domain) ──
CORS_ALLOWED_ORIGINS=https://your-domain.com
