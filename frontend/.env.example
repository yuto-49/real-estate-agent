# will expose them at `/api/config/public` for the frontend runtime:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY
#   VITE_API_BASE_URL
#   VITE_WS_URL
#   VITE_MAP_STYLE_URL
