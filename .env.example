# ============================================================================
# Production Platform
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxx           # Claude API (production agents)
TOMTOM_API_KEY=xxxxx                     # TomTom Maps (geocoding + neighborhood, free tier)
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/realestate
ZILLOW_API_KEY=                          # Listings + comps (Bridge/RapidAPI)
ATTOM_API_KEY=                           # Property records (optional)
ESTAT_APP_ID=                           # e-Stat Japan API (free, https://www.e-stat.go.jp/en/mypage/login)
REINFOLIB_API_KEY=                      # MLIT Real Estate Info Library (https://www.reinfolib.mlit.go.jp/api/request/)
REDIS_URL=redis://localhost:6379/0
# Intelligence reports: mock = synthetic math (no external service); live = POST /api/simulate to MIROFISH_API_URL
# Dev shim when live (real MiroFish is not in this repo): `python scripts/dev_mirofish_stub.py` → :5001
MIROFISH_MODE=mock
MIROFISH_API_URL=http://localhost:5001

# App config
ENVIRONMENT=development                  # set to "production" to enforce auth on every endpoint
LOG_LEVEL=INFO
MAX_DEAL_VALUE_AUTO=2000000
MIN_OFFER_PERCENT=0.50
MAX_COUNTER_ROUNDS=10

# ============================================================================
# Supabase Auth (see doc/SUPABASE_AUTH_SETUP.md)
# ============================================================================
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated      # default for Supabase user JWTs; rarely change
# SUPABASE_JWT_SECRET=                   # only for legacy HS256 projects without JWKS
# SUPABASE_SERVICE_ROLE_KEY=             # admin key — required ONLY by scripts/create_dev_user.py

# Frontend Supabase (publishable / anon key — safe to ship)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ============================================================================
# MiroFish (inside MiroFish/ subdirectory — separate .env)
# ============================================================================
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_NAME=qwen2.5:14b
# ZEP_API_KEY=z_xxxxxxxxxxxxxxxxxxxxxxxx
